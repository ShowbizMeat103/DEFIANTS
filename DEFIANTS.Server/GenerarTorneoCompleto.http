@hostname = http://localhost
@port = 5031
@run_id = {{$random.integer}}

# --- 1. ADMIN Y TORNEO ---
POST {{hostname}}:{{port}}/api/auth/login
Content-Type: application/json

{ "username": "Sartox5", "password": "Jdum2508!" }

> {% client.global.set("admin_token", response.body.token); %}

### Crear Torneo
POST {{hostname}}:{{port}}/api/torneos
Authorization: Bearer {{admin_token}}
Content-Type: application/json

{
  "titulo": "Torneo Test {{run_id}}",
  "juegoId": 1,
  "maxEquipos": 4,
  "precioInscripcion": 0,
  "prizePool": 1000,
  "fechaInicio": "2025-12-25T12:00:00Z"
}

> {% client.global.set("tournament_id", response.body.id); %}


# --- JUGADOR 1 ---
### Registrar User 1
POST {{hostname}}:{{port}}/api/auth/register
Content-Type: application/json

{ "username": "User1_{{run_id}}", "email": "u1_{{run_id}}@test.com", "password": "Password123!" }

### Login User 1
POST {{hostname}}:{{port}}/api/auth/login
Content-Type: application/json

{ "username": "User1_{{run_id}}", "password": "Password123!" }

> {% client.global.set("token_p1", response.body.token); %}

### Crear Perfil User 1 (ESTO FALTABA)
POST {{hostname}}:{{port}}/api/perfilesjuego
Authorization: Bearer {{token_p1}}
Content-Type: application/json

{ "juegoId": 1, "nicknameInGame": "Pro1_{{run_id}}", "elo": 1000 }

### Crear Equipo 1
POST {{hostname}}:{{port}}/api/equipos
Authorization: Bearer {{token_p1}}
Content-Type: application/json

{ "nombre": "Team One {{run_id}}", "juegoId": 1 }

> {% client.global.set("team_id_1", response.body.id); %}

### Inscribir Equipo 1
POST {{hostname}}:{{port}}/api/torneos/{{tournament_id}}/inscripciones
Authorization: Bearer {{token_p1}}
Content-Type: application/json

{ "equipoId": {{team_id_1}} }



