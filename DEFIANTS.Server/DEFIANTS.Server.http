@hostname = http://localhost
@port = 5031

### 0. (MANUAL) Registrar adminuser - Ejecuta solo esta petición la primera vez
# Después de ejecutarla, ve a tu base de datos y asigna manualmente el rol "Admin" a este usuario.
# Una vez hecho, puedes ejecutar el resto del script.
POST {{hostname}}:{{port}}/api/auth/register
Content-Type: application/json

{
  "username": "adminuser",
  "email": "admin@example.com",
  "password": "AdminPass123!"
}

### SEPARADOR ###

### 1. Login adminuser y capturar token de ADMIN
POST {{hostname}}:{{port}}/api/auth/login
Content-Type: application/json

{
  "username": "Sartox1",
  "password": "Supergenial123!"
}

> {%
    client.global.set("admin_token", response.body.token);
    client.log("✅ Token de ADMIN capturado: " + client.global.get("admin_token"));
%}

### 2. Registrar user1 (Jugador)
POST {{hostname}}:{{port}}/api/auth/register
Content-Type: application/json

{
  "username": "testuser1",
  "email": "testuser1@example.com",
  "password": "Password123!"
}

### 3. Login user1 y capturar token de JUGADOR
POST {{hostname}}:{{port}}/api/auth/login
Content-Type: application/json

{
  "username": "testuser1",
  "password": "Password123!"
}

> {%
    client.global.set("jwt_token", response.body.token);
    client.log("✅ Token de JUGADOR (user1) capturado: " + client.global.get("jwt_token"));
%}

### 4. Crear un Juego (como Admin) y capturar ID
POST {{hostname}}:{{port}}/api/admin/juegos
Authorization: Bearer {{admin_token}}
Content-Type: application/json

{
  "nombre": "League of Legends",
  "integrantesPorEquipo": 5
}

> {%
    if (response.status === 201) {
        client.global.set("game_id", response.body.id);
        client.log(`✅ Juego '${response.body.nombre}' creado con ID: ${client.global.get("game_id")}`);
    } else {
        client.log("❌ Error al crear el juego: " + response.status);
    }
%}

### 5. Crear Perfil de Juego para user1 (como Jugador)
POST {{hostname}}:{{port}}/api/perfilesjuego
Authorization: Bearer {{jwt_token}}
Content-Type: application/json

{
  "juegoId": {{game_id}},
  "nicknameInGame": "TheLegend27"
}

> {%
    if (response.status === 200) {
        client.log(`✅ Perfil '${response.body.nicknameInGame}' creado para user1 con ID: ${response.body.id}`);
    }
%}

### 6. Crear Equipo para user1 (como Jugador) y capturar ID
POST {{hostname}}:{{port}}/api/equipos
Authorization: Bearer {{jwt_token}}
Content-Type: application/json

{
  "nombre": "Equipo Alpha",
  "juegoId": {{game_id}}
}

> {%
    if (response.status === 201) {
        client.global.set("team_id_user1", response.body.id);
        client.log(`✅ Equipo '${response.body.nombre}' creado con ID: ${client.global.get("team_id_user1")}`);
    } else {
        client.log("❌ Error al crear el Equipo Alpha: " + response.status);
    }
%}

