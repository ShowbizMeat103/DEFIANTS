### 11. Crear Torneo (como Admin) y capturar ID
POST {{hostname}}:{{port}}/api/torneos
Authorization: Bearer {{admin_token}}
Content-Type: application/json

{
  "titulo": "Torneo de Verano",
  "juegoId": {{game_id}},
  "maxEquipos": 4
}

> {%
    if (response.status === 201) {
        client.global.set("tournament_id", response.body.id);
        client.log(`✅ Torneo '${response.body.titulo}' creado con ID: ${client.global.get("tournament_id")}`);
    } else {
        client.log("❌ Error al crear el torneo: " + response.status);
    }
%}

### 12. Inscribir Equipo Alpha en Torneo (como user1)
POST {{hostname}}:{{port}}/api/torneos/{{tournament_id}}/inscripciones
Authorization: Bearer {{jwt_token}}
Content-Type: application/json

{
  "equipoId": {{team_id_user1}}
}

> {% client.log(`✅ Equipo Alpha (ID: ${client.global.get("team_id_user1")}) inscrito en Torneo (ID: ${client.global.get("tournament_id")}).`); %}

### 13. Inscribir Equipo Beta en Torneo (como user2)
POST {{hostname}}:{{port}}/api/torneos/{{tournament_id}}/inscripciones
Authorization: Bearer {{jwt_token_user2}}
Content-Type: application/json

{
  "equipoId": {{team_id_user2}}
}

> {% client.log(`✅ Equipo Beta (ID: ${client.global.get("team_id_user2")}) inscrito en Torneo (ID: ${client.global.get("tournament_id")}).`); %}

### 14. Iniciar el Torneo (como Admin)
POST {{hostname}}:{{port}}/api/torneos/{{tournament_id}}/iniciar
Authorization: Bearer {{admin_token}}

> {% client.log(`✅ Torneo (ID: ${client.global.get("tournament_id")}) iniciado.`); %}

### 15. Verificar Bracket Generado (público) y capturar IDs
GET {{hostname}}:{{port}}/api/torneos/{{tournament_id}}

> {%
    const partidos = response.body.partidos;
    if (partidos && partidos.length > 0) {
        const primerPartidoR1 = partidos.find(p => p.ronda === 1);
        if (primerPartidoR1) {
            client.global.set("match_id_r1", primerPartidoR1.id);
            client.global.set("team_id_r1_a", primerPartidoR1.equipoAId);
            client.log(`✅ Bracket verificado. Primer partido R1 (ID: ${primerPartidoR1.id}): '${primerPartidoR1.equipoANombre}' vs '${primerPartidoR1.equipoBNombre}'`);
        }
    }
%}

### 16. Reportar Victoria en un Partido (como Admin)
POST {{hostname}}:{{port}}/api/torneos/partidos/{{match_id_r1}}/victoria
Authorization: Bearer {{admin_token}}
Content-Type: application/json

{{team_id_r1_a}}

> {% client.log(`✅ Victoria reportada para el equipo con ID: ${client.global.get("team_id_r1_a")}`); %}

### 17. Verificar Avance en el Bracket (público)
GET {{hostname}}:{{port}}/api/torneos/{{tournament_id}}

> {%
    const partidos = response.body.partidos;
    const partidoR1 = partidos.find(p => p.id == client.global.get("match_id_r1"));
    if (partidoR1 && partidoR1.estado === "Finalizado") {
        client.log(`✅ Verificación de avance: El partido (ID: ${partidoR1.id}) está '${partidoR1.estado}'.`);
    } else {
        client.log("❌ Verificación de avance: El partido de R1 NO está finalizado.");
    }
%}

### 18. Test: Acceso Prohibido (Jugador intenta acción de Admin)
POST {{hostname}}:{{port}}/api/admin/juegos
Authorization: Bearer {{jwt_token}}
Content-Type: application/json

{
  "nombre": "Juego Prohibido"
}

> {%
    client.test("Request should fail with 403 Forbidden", function() {
        client.assert(response.status === 403, "Expected 403 Forbidden, but got " + response.status);
    });
    client.log("✅ Test de Acceso Prohibido superado.");
%}
