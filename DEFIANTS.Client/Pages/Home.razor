@page "/"

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet" />
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

<div class="landing">

    

    <main>
        <!-- HERO -->
        <div class="container">
            <header class="hero">
                <p class="hero-status">/// SYSTEM_READY /// V.2.0.1</p>

                <h1 class="glitch-wrapper">
                    <span class="glitch-text" data-text="DEFIANTS">DEFIANTS</span>
                </h1>

                <p class="hero-copy">
                    LA ARENA DE CAOS CONTROLADO. <br />
                    DONDE LA GEOMETRÍA SE ROMPE Y TÚ DEMUESTRAS QUIÉN ERES.
                </p>

                <div class="hero-actions">
                    <a href="/login" class="btn btn-primary">UNIRSE A LA ARENA</a>
                    <a href="/noticias" class="btn btn-secondary btn-ghost">
                        <i class="fas fa-bullhorn"></i> Ver noticias
                    </a>
                </div>
            </header>
        </div>

        <!-- SECCIÓN: QUÉ ES DEFIANTS -->
        <section class="section section-about">
            <div class="container">
                <div class="section-header">
                    <h2 class="section-title">// ¿QUÉ ES DEFIANTS?</h2>
                    <p class="section-subtitle">
                        Una plataforma competitiva diseñada para jugar, medir tu nivel
                        y escalar en un ecosistema de torneos que no perdona errores.
                    </p>
                </div>

                <div class="about-grid">
                    <div class="about-card">
                        <h3>Matchmaking Competitivo</h3>
                        <p>
                            Emparejamientos pensados para generar partidas intensas,
                            justas y con enfoque en el rendimiento real del jugador.
                        </p>
                    </div>
                    <div class="about-card">
                        <h3>Estadísticas en Tiempo Real</h3>
                        <p>
                            K/D, winrate, desempeño por mapa y más.  
                            Tus números hablan por ti, tú solo concéntrate en ganar.
                        </p>
                    </div>
                    <div class="about-card">
                        <h3>Identidad Gamer</h3>
                        <p>
                            Gametag único, perfil personalizable y logros que desbloqueas
                            al competir en la arena DEFIANTS.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- SECCIÓN: FEATURES / MÓDULOS -->
        <section class="section section-features">
            <div class="container">
                <div class="section-header">
                    <h2 class="section-title">// SISTEMAS DEL NÚCLEO</h2>
                    <p class="section-subtitle">
                        Módulos pensados para administrar torneos, jugadores y resultados
                        como si fuera una operación militar.
                    </p>
                </div>

                <div class="features-grid">
                    <div class="feature-card">
                        <div class="feature-icon">
                            <i class="fas fa-trophy"></i>
                        </div>
                        <h3>Gestor de Torneos</h3>
                        <p>
                            Crea brackets, administra rondas y controla cada fase
                            del torneo desde una sola interfaz.
                        </p>
                    </div>

                    <div class="feature-card">
                        <div class="feature-icon">
                            <i class="fas fa-users-cog"></i>
                        </div>
                        <h3>Control de Jugadores</h3>
                        <p>
                            Perfiles, roles, equipos y sanciones.  
                            Todo bajo un sistema de permisos bien definido.
                        </p>
                    </div>

                    <div class="feature-card">
                        <div class="feature-icon">
                            <i class="fas fa-bullhorn"></i>
                        </div>
                        <h3>Convocatorias</h3>
                        <p>
                            Publica nuevas competencias, filtra por juego, rango
                            y fecha de inscripción.
                        </p>
                    </div>

                    <div class="feature-card">
                        <div class="feature-icon">
                            <i class="fas fa-chart-line"></i>
                        </div>
                        <h3>Panel de Admin</h3>
                        <p>
                            Métricas globales de actividad, participación y resultados.
                            Ideal para ligas, clubes o comunidades serias.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- SECCIÓN: PRÓXIMOS TORNEOS -->
        <section class="section section-tournaments">
            <div class="container">
                <div class="section-header">
                    <h2 class="section-title">// PRÓXIMOS TORNEOS</h2>
                    <p class="section-subtitle">
                        Alístate para las siguientes batallas.  
                        Los lugares son limitados y la competencia no espera.
                    </p>
                </div>

                <div class="tournaments-grid">
                    <article class="tournament-card">
                        <span class="tournament-tag">VALORANT · 5v5</span>
                        <h3>Defiants Clash: Neon Protocol</h3>
                        <p class="tournament-info">
                            <i class="fas fa-calendar-alt"></i> 18 de enero 2026 · Online  
                            <i class="fas fa-users"></i> 32 equipos · Eliminación directa
                        </p>
                        <a href="/noticias" class="tournament-cta">Ver detalles</a>
                    </article>

                    <article class="tournament-card">
                        <span class="tournament-tag">LoL · Ranked</span>
                        <h3>Summoner’s Grid: Tier Trials</h3>
                        <p class="tournament-info">
                            <i class="fas fa-calendar-alt"></i> 10 de febrero 2026 · Online  
                            <i class="fas fa-star"></i> Elo mínimo: Platino II
                        </p>
                        <a href="/noticias" class="tournament-cta">Ver convocatoria</a>
                    </article>

                    <article class="tournament-card">
                        <span class="tournament-tag">MULTI GAME</span>
                        <h3>DEFIANTS League · Temporada 1</h3>
                        <p class="tournament-info">
                            <i class="fas fa-calendar-alt"></i> Próximamente  
                            <i class="fas fa-gamepad"></i> Shooters · MOBAs · Fighting
                        </p>
                        <a href="/noticias" class="tournament-cta">Recibir avisos</a>
                    </article>
                </div>
            </div>
        </section>

        <!-- SECCIÓN: STATS / CONFIANZA -->
        <section class="section section-stats">
            <div class="container stats-strip">
                <div class="stat-item">
                    <span class="stat-number">+2500</span>
                    <span class="stat-label">Jugadores registrados</span>
                </div>
                <div class="stat-item">
                    <span class="stat-number">+120</span>
                    <span class="stat-label">Torneos organizados</span>
                </div>
                <div class="stat-item">
                    <span class="stat-number">99.8%</span>
                    <span class="stat-label">Uptime del sistema</span>
                </div>
            </div>
        </section>

        <!-- CTA FINAL -->
        <section class="section section-cta-final">
            <div class="container cta-final-inner">
                <div>
                    <h2 class="section-title">// ¿LISTO PARA ENTRAR?</h2>
                    <p class="section-subtitle">
                        Crea tu perfil, arma tu escuadra y deja que tus estadísticas
                        hablen por ti. La arena no espera.
                    </p>
                </div>
                <div class="cta-buttons">
                    <a href="/registro" class="btn btn-primary">CREAR CUENTA</a>
                    <a href="/login" class="btn btn-secondary btn-ghost">
                        YA TENGO CUENTA
                    </a>
                </div>
            </div>
        </section>
    </main>

    

</div>
