@page "/cuenta/dashboard"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using DEFIANTS.Shared.Clients
@using DEFIANTS.Shared.DTOs
@inject IApiClient ApiClient

<PageTitle>Dashboard - DEFIANTS</PageTitle>

<!-- Aseguramos que las fuentes e iconos estén disponibles -->
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet" />
<link href="https://fonts.googleapis.com/css2?family=Anton&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet" />

<div class="dashboard-layout">
    <div class="container">

        <!-- HEADER / BIENVENIDA -->
        <header class="dashboard-header">
            <div class="header-content">
                <p class="system-status">/// SYSTEM_CONNECTED /// V.2.0.1</p>
                <AuthorizeView>
                    <Authorized>
                        <h1>
                            HOLA, <span class="user-highlight">@context.User.Identity?.Name?.ToUpper()</span>
                        </h1>
                    </Authorized>
                    <NotAuthorized>
                        <h1>HOLA, <span class="user-highlight">AGENTE</span></h1>
                    </NotAuthorized>
                </AuthorizeView>
                <p class="header-subtitle">Bienvenido al centro de comando. Revisa tus estadísticas y gestiona tu próxima batalla.</p>
            </div>
            <div class="header-stats">
                <div class="stat-badge">
                    <span class="label">ESTADO</span>
                    <span class="value online">EN LÍNEA</span>
                </div>
            </div>
        </header>

        <!-- SECCIÓN 1: MIS EQUIPOS -->
        <section class="dashboard-section">
            <div class="section-title-bar">
                <h2>// MIS EQUIPOS</h2>
                <div class="section-actions">
                    <a href="/equipos/gestion" class="btn-link">[Crear Nuevo Equipo]</a>
                    <a href="/equipos/gestion" class="btn-link">[Ver Todos]</a>
                </div>
            </div>
            <div class="dashboard-grid grid-teams">
                @if (isLoading)
                {
                    <p>Cargando equipos...</p>
                }
                else if (misEquipos != null && misEquipos.Any())
                {
                    @foreach (var equipo in misEquipos)
                    {
                        <article class="dashboard-card team-card">
                            <div class="card-header">
                                <h3>@equipo.Nombre.ToUpper()</h3>
                                <span class="tag game-lol">@GetJuegoNombre(equipo.JuegoId)</span>
                            </div>
                            <div class="card-body">
                                <div class="data-row">
                                    <span class="label">Rol:</span>
                                    <span class="value">@equipo.Rol</span>
                                </div>
                                <div class="data-row">
                                    <span class="label">Miembros:</span>
                                    <span class="value">@equipo.CantidadMiembros</span>
                                </div>
                            </div>
                            <div class="card-footer">
                                <a href="/equipos/gestion" class="btn-action">GESTIONAR</a>
                            </div>
                        </article>
                    }
                }
                else
                {
                    <p>Aún no perteneces a ningún equipo.</p>
                }
            </div>
        </section>

        <!-- SECCIÓN 2: MIS TORNEOS -->
        <section class="dashboard-section">
            <div class="section-title-bar">
                <h2>// MIS TORNEOS</h2>
                <div class="section-actions">
                    <a href="/tournaments" class="btn-link">[Explorar Torneos]</a>
                </div>
            </div>
            <div class="dashboard-grid col-2">
                @if (isLoading)
                {
                    <p>Cargando torneos...</p>
                }
                else if (misInscripciones != null && misInscripciones.Any())
                {
                    @foreach (var inscripcion in misInscripciones)
                    {
                        <article class="dashboard-card tournament-card @GetTournamentStatusClass(inscripcion.Status)">
                            <div class="status-indicator"></div>
                            <div class="card-content">
                                <h3>@inscripcion.TorneoTitulo.ToUpper()</h3>
                                <div class="meta-info">
                                    <span><i class="fas fa-circle status-dot"></i> @inscripcion.Status</span>
                                    <span><i class="fas fa-users"></i> @inscripcion.NombreEquipo</span>
                                </div>
                            </div>
                            <a href="/torneos/@inscripcion.TorneoId" class="card-arrow"><i class="fas fa-chevron-right"></i></a>
                        </article>
                    }
                }
                else
                {
                    <p>No estás inscrito en ningún torneo.</p>
                }
            </div>
        </section>

        <!-- SECCIÓN 3: PRÓXIMOS PARTIDOS -->
        <section class="dashboard-section">
            <div class="section-title-bar">
                <h2>// PRÓXIMOS PARTIDOS</h2>
            </div>
            <div class="dashboard-grid col-1">
                @if (isLoading)
                {
                    <p>Cargando partidos...</p>
                }
                else if (misPartidos != null && misPartidos.Any())
                {
                    @foreach (var partido in misPartidos)
                    {
                        <article class="dashboard-card match-card">
                            <div class="match-info">
                                <span class="match-tournament">TORNEO ID: @partido.Id</span>
                                <span class="match-round">RONDA @partido.Ronda</span>
                            </div>
                            <div class="match-versus">
                                <span class="team-name own-team">@partido.EquipoANombre?.ToUpper()</span>
                                <span class="vs">VS</span>
                                <span class="team-name enemy-team">@partido.EquipoBNombre?.ToUpper()</span>
                            </div>
                            <div class="match-action">
                                <span class="match-time">@partido.Estado.ToString().ToUpper()</span>
                                <a href="/partidos/@partido.Id" class="btn-small">SALA DE JUEGO</a>
                            </div>
                        </article>
                    }
                }
                else
                {
                    <p>No tienes partidos próximos.</p>
                }
            </div>
        </section>

        <!-- SECCIÓN 4: ACCIONES RÁPIDAS -->
        <section class="dashboard-section section-quick-actions">
            <div class="section-title-bar">
                <h2>// ACCIONES RÁPIDAS</h2>
            </div>
            <div class="actions-grid">
                <a href="/mis-perfiles-juego" class="quick-action-btn">
                    <i class="fas fa-id-card"></i>
                    <span>Mis Perfiles</span>
                </a>
                <a href="/torneos/crear" class="quick-action-btn">
                    <i class="fas fa-plus-square"></i>
                    <span>Crear Torneo</span>
                </a>
                <a href="/configuracion" class="quick-action-btn">
                    <i class="fas fa-cog"></i>
                    <span>Configuración</span>
                </a>
            </div>
        </section>

        <!-- SECCIÓN 5: ADMIN PANEL (Condicional) -->
        <AuthorizeView Roles="Admin">
            <Authorized>
                <section class="dashboard-section section-admin">
                    <div class="section-title-bar">
                        <h2>// PANEL DE ADMINISTRACIÓN</h2>
                        <span class="admin-badge">NIVEL 5 - ACCESO TOTAL</span>
                    </div>
                    <div class="actions-grid">
                        <a href="/admin/usuarios" class="admin-btn">
                            <i class="fas fa-user-shield"></i> Gestionar Usuarios
                        </a>
                        <a href="/admin/juegos" class="admin-btn">
                            <i class="fas fa-gamepad"></i> Gestionar Juegos
                        </a>
                    </div>
                </section>
            </Authorized>
        </AuthorizeView>

    </div>
</div>

@code {
    private List<MiEquipoDto>? misEquipos;
    private List<MiInscripcionDto>? misInscripciones;
    private List<PartidoDto>? misPartidos;
    private List<JuegoDto>? juegos;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var equiposTask = ApiClient.GetMisEquipos();
            var inscripcionesTask = ApiClient.GetMisInscripciones();
            var partidosTask = ApiClient.GetMisPartidos();
            var juegosTask = ApiClient.GetJuegos();

            await Task.WhenAll(equiposTask, inscripcionesTask, partidosTask, juegosTask);

            misEquipos = await equiposTask;
            misInscripciones = await inscripcionesTask;
            misPartidos = await partidosTask;
            juegos = await juegosTask;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar los datos del dashboard: {ex.Message}");
            misEquipos ??= new List<MiEquipoDto>();
            misInscripciones ??= new List<MiInscripcionDto>();
            misPartidos ??= new List<PartidoDto>();
            juegos ??= new List<JuegoDto>();
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetJuegoNombre(int juegoId)
    {
        return juegos?.FirstOrDefault(j => j.Id == juegoId)?.Nombre?.ToUpper() ?? "DESCONOCIDO";
    }

    private string GetTournamentStatusClass(string status)
    {
        return status switch
        {
            "EnCurso" => "active",
            "InscripcionesAbiertas" => "open",
            "Finalizado" => "finished",
            _ => "default"
        };
    }
}
