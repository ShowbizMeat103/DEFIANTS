@page "/cuenta/dashboard"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization

<PageTitle>Dashboard - DEFIANTS</PageTitle>

<!-- Aseguramos que las fuentes e iconos estén disponibles -->
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet" />
<link href="https://fonts.googleapis.com/css2?family=Anton&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet" />

<div class="dashboard-layout">
    <div class="container">

        <!-- HEADER / BIENVENIDA -->
        <header class="dashboard-header">
            <div class="header-content">
                <p class="system-status">/// SYSTEM_CONNECTED /// V.2.0.1</p>
                <AuthorizeView>
                    <Authorized>
                        <h1>
                            HOLA, <span class="user-highlight">@context.User.Identity?.Name?.ToUpper()</span>
                        </h1>
                    </Authorized>
                    <NotAuthorized>
                        <h1>HOLA, <span class="user-highlight">AGENTE</span></h1>
                    </NotAuthorized>
                </AuthorizeView>
                <p class="header-subtitle">Bienvenido al centro de comando. Revisa tus estadísticas y gestiona tu próxima batalla.</p>
            </div>

            <!-- ACCIONES RÁPIDAS (Movido arriba para acceso inmediato o según preferencia,
                 pero el esquema lo pone abajo. Lo pondré abajo según esquema,
                 pero dejo este espacio por si quieres status global) -->
            <div class="header-stats">
                <div class="stat-badge">
                    <span class="label">ESTADO</span>
                    <span class="value online">EN LÍNEA</span>
                </div>
            </div>
        </header>

        <!-- SECCIÓN 1: MIS EQUIPOS -->
        <section class="dashboard-section">
            <div class="section-title-bar">
                <h2>// MIS EQUIPOS</h2>
                <div class="section-actions">
                    <a href="/equipos/crear" class="btn-link">[Crear Nuevo Equipo]</a>
                    <a href="/cuenta/equipos" class="btn-link">[Ver Todos]</a>
                </div>
            </div>

            <div class="dashboard-grid col-2">
                <!-- Tarjeta Equipo 1 -->
                <article class="dashboard-card team-card">
                    <div class="card-header">
                        <h3>EQUIPO ALPHA</h3>
                        <span class="tag game-lol">LoL</span>
                    </div>
                    <div class="card-body">
                        <div class="data-row">
                            <span class="label">Rol:</span>
                            <span class="value">Capitán</span>
                        </div>
                        <div class="data-row">
                            <span class="label">Miembros:</span>
                            <span class="value">5/5</span>
                        </div>
                    </div>
                    <div class="card-footer">
                        <a href="/equipos/1" class="btn-action">GESTIONAR</a>
                    </div>
                </article>

                <!-- Tarjeta Equipo 2 -->
                <article class="dashboard-card team-card">
                    <div class="card-header">
                        <h3>EQUIPO BETA</h3>
                        <span class="tag game-val">VALORANT</span>
                    </div>
                    <div class="card-body">
                        <div class="data-row">
                            <span class="label">Rol:</span>
                            <span class="value">Titular</span>
                        </div>
                        <div class="data-row">
                            <span class="label">Miembros:</span>
                            <span class="value">4/5</span>
                        </div>
                    </div>
                    <div class="card-footer">
                        <a href="/equipos/2" class="btn-action">GESTIONAR</a>
                    </div>
                </article>
            </div>
        </section>

        <!-- SECCIÓN 2: MIS TORNEOS -->
        <section class="dashboard-section">
            <div class="section-title-bar">
                <h2>// MIS TORNEOS</h2>
                <div class="section-actions">
                    <a href="/torneos" class="btn-link">[Explorar Torneos]</a>
                </div>
            </div>

            <div class="dashboard-grid col-2">
                <!-- Torneo 1 -->
                <article class="dashboard-card tournament-card active">
                    <div class="status-indicator"></div>
                    <div class="card-content">
                        <h3>TORNEO DE VERANO</h3>
                        <div class="meta-info">
                            <span><i class="fas fa-circle status-dot"></i> En Curso</span>
                            <span><i class="fas fa-users"></i> Equipo Alpha</span>
                        </div>
                    </div>
                    <a href="/torneos/1" class="card-arrow"><i class="fas fa-chevron-right"></i></a>
                </article>

                <!-- Torneo 2 -->
                <article class="dashboard-card tournament-card open">
                    <div class="status-indicator"></div>
                    <div class="card-content">
                        <h3>COPA DE INVIERNO</h3>
                        <div class="meta-info">
                            <span><i class="far fa-circle status-dot"></i> Insc. Abiertas</span>
                            <span><i class="fas fa-users"></i> Equipo Beta</span>
                        </div>
                    </div>
                    <a href="/torneos/2" class="card-arrow"><i class="fas fa-chevron-right"></i></a>
                </article>
            </div>
        </section>

        <!-- SECCIÓN 3: PRÓXIMOS PARTIDOS -->
        <section class="dashboard-section">
            <div class="section-title-bar">
                <h2>// PRÓXIMOS PARTIDOS</h2>
                <div class="section-actions">
                    <a href="/partidos" class="btn-link">[Ver Todos Mis Partidos]</a>
                </div>
            </div>

            <div class="dashboard-grid col-1">
                <!-- Partido Row -->
                <article class="dashboard-card match-card">
                    <div class="match-info">
                        <span class="match-tournament">TORNEO X</span>
                        <span class="match-round">RONDA 2</span>
                    </div>
                    <div class="match-versus">
                        <span class="team-name own-team">ALPHA</span>
                        <span class="vs">VS</span>
                        <span class="team-name enemy-team">GAMMA</span>
                    </div>
                    <div class="match-action">
                        <span class="match-time">20:00 HRS</span>
                        <a href="/partidos/123" class="btn-small">SALA DE JUEGO</a>
                    </div>
                </article>
            </div>
        </section>

        <!-- SECCIÓN 4: ACCIONES RÁPIDAS -->
        <section class="dashboard-section section-quick-actions">
            <div class="section-title-bar">
                <h2>// ACCIONES RÁPIDAS</h2>
            </div>
            <div class="actions-grid">
                <a href="/cuenta/perfiles" class="quick-action-btn">
                    <i class="fas fa-id-card"></i>
                    <span>Mis Perfiles</span>
                </a>
                <a href="/torneos/crear" class="quick-action-btn">
                    <i class="fas fa-plus-square"></i>
                    <span>Crear Torneo</span>
                </a>
                <a href="/configuracion" class="quick-action-btn">
                    <i class="fas fa-cog"></i>
                    <span>Configuración</span>
                </a>
            </div>
        </section>

        <!-- SECCIÓN 5: ADMIN PANEL (Condicional) -->
        <AuthorizeView Roles="Admin">
            <Authorized>
                <section class="dashboard-section section-admin">
                    <div class="section-title-bar">
                        <h2>// PANEL DE ADMINISTRACIÓN</h2>
                        <span class="admin-badge">NIVEL 5 - ACCESO TOTAL</span>
                    </div>
                    <div class="actions-grid">
                        <a href="/admin/usuarios" class="admin-btn">
                            <i class="fas fa-user-shield"></i> Gestionar Usuarios
                        </a>
                        <a href="/admin/juegos" class="admin-btn">
                            <i class="fas fa-gamepad"></i> Gestionar Juegos
                        </a>
                    </div>
                </section>
            </Authorized>
        </AuthorizeView>

    </div>
</div>

@code {
    // Aquí iría la carga de datos real mediante IApiClient
    // Por ahora usamos la estructura estática para diseño
}