@page "/dashboard"

<h1>Dashboard</h1>

<div class="row">
    <div class="col-md-4">
        <Card Title="Resultados del Torneo de Verano"
              Description="Los ganadores del torneo de verano han sido anunciados."
              ImageUrl="https://via.placeholder.com/300x200"
              Link="/tournaments/verano/results"
              ButtonText="Ver Resultados" />
    </div>
    <div class="col-md-4">
        <Card Title="Nuevo Torneo: Desafío de Otoño"
              Description="Se ha abierto la inscripción para el nuevo Desafío de Otoño."
              ImageUrl="https://via.placeholder.com/300x200"
              Link="/tournaments/otono"
              ButtonText="Inscribirse" />
    </div>
    <div class="col-md-4">
        <Card Title="Actualización de Reglas"
              Description="Se han actualizado las reglas para la temporada 2025."
              ImageUrl="https://via.placeholder.com/300x200"
              Link="/rules"
              ButtonText="Leer Reglas" />
    </div>
</div>
