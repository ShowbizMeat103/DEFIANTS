@page "/equipos/gestion"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using DEFIANTS.Shared.Clients
@using DEFIANTS.Shared.DTOs
@inject IApiClient ApiClient
@inject NavigationManager Navigation

<div class="section section-teams">
    <div class="container">
        <div class="section-header">
            <h1 class="section-title">Gestión de Equipos</h1>
            <p class="section-subtitle">Crea y administra tus equipos. Sólo los capitanes pueden editar o disolver.</p>
        </div>

        <div class="team-management">
            <div class="create-team">
                <h3>Crear nuevo equipo</h3>
                <EditForm Model="newTeam" OnValidSubmit="CreateTeam">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="form-group">
                        <label>Nombre del equipo</label>
                        <InputText class="form-control" @bind-Value="newTeam.Nombre" />
                    </div>

                    <div class="form-group">
                        <label>Juego</label>
                        <InputSelect class="form-control" @bind-Value="newTeam.JuegoId">
                            <option value="0">-- Selecciona --</option>
                            @foreach (var j in juegosDisponiblesParaCrear)
                            {
                                <option value="@j.Id">@j.Nombre</option>
                            }
                        </InputSelect>
                        @if (!juegosDisponiblesParaCrear.Any() && !isLoading)
                        {
                            <small class="text-danger d-block mt-1">
                                No tienes perfiles de juego. <a href="/mis-perfiles-juego">Crea uno primero</a> para poder armar un equipo.
                            </small>
                        }
                    </div>

                    <div style="margin-top:12px">
                        <button class="btn-primary" type="submit" disabled="@(isCreating || !juegosDisponiblesParaCrear.Any())">
                            @((isCreating) ? "Creando..." : "Crear equipo")
                        </button>
                    </div>
                </EditForm>
                @if (!string.IsNullOrEmpty(createMessage)) { <div class="info">@createMessage</div> }
                @if (!string.IsNullOrEmpty(createError)) { <div class="error">@createError</div> }
            </div>

            <div class="my-teams">
                <div style="display:flex; align-items:flex-end; margin-bottom:12px; border-left: 4px solid #E62020; padding-left:16px;">
                    <h2 style="margin:0; font-family:'Anton'; text-transform:uppercase; font-size:2rem; line-height:1;">// Mis Equipos</h2>
                </div>

                @if (isLoading)
                {
                    <div style="color:#888;">Cargando equipos...</div>
                }
                else if (!string.IsNullOrEmpty(loadError))
                {
                    <div class="error">Error: @loadError</div>
                }
                else
                {
                    @if (misEquipos == null || !misEquipos.Any())
                    {
                        <div style="color:#666; padding:20px 0;">No tienes equipos todavía.</div>
                    }
                    else
                    {
                        <div class="teams-list">
                            @foreach (var t in misEquipos)
                            {
                                var nombreJuego = GetJuegoNombre(t.JuegoId);
                                var tagClass = nombreJuego.ToLower().Contains("valorant") ? "valorant" : 
                                               nombreJuego.ToLower().Contains("lol") || nombreJuego.ToLower().Contains("league") ? "lol" : "";

                                <div class="team-banner">
                                    <div class="banner-header">
                                        <h3 class="team-name">@t.Nombre</h3>
                                        <span class="game-tag @tagClass">@nombreJuego</span>
                                    </div>

                                    <div class="banner-info">
                                        <div class="info-row">
                                            <span class="info-label">Rol:</span>
                                            <span style="color:#fff;">@t.Rol</span>
                                        </div>
                                        <div class="info-row">
                                            <span class="info-label">ID:</span>
                                            <span>#@t.Id.ToString("D4")</span>
                                        </div>
                                    </div>

                                    <div class="banner-actions">
                                        @if (t.IsEditing)
                                        {
                                            <div class="inline-editor">
                                                <InputText class="form-control" @bind-Value="t.EditNombre" placeholder="Nuevo nombre..." />
                                                @if (!string.IsNullOrEmpty(t.EditError)) { <div class="error" style="font-size:0.8rem">@t.EditError</div> }
                                                
                                                <div style="margin-top:10px; display:flex; gap:8px;">
                                                    <button class="btn-primary" @onclick="() => SaveEdit(t)" disabled="@t.IsSaving">Guardar</button>
                                                    <button class="btn-ghost" @onclick="() => CancelEdit(t)">Cancelar</button>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <button class="btn-manage" @onclick="() => ViewEquipo(t.Id)">
                                                GESTIONAR
                                            </button>

                                            <div class="small-actions">
                                                <a class="small-link" @onclick="() => ToggleEdit(t)">[Editar Nombre]</a>
                                                <a class="small-link" @onclick="() => ConfirmDisolver(t.Id)" style="color:#a33;">[Disolver]</a>
                                            </div>
                                        }

                                        @if (!t.IsEditing) 
                                        {
                                            <div style="margin-top:16px; border-top:1px dashed #333; padding-top:12px;">
                                                <div style="display:flex; gap:4px;">
                                                    <InputText placeholder="Invitar usuario..." @bind-Value="t.InviteUsername" class="form-control" style="padding:6px; font-size:0.85rem;" />
                                                    <button class="btn-ghost" @onclick="() => InviteToTeam(t)" disabled="@t.IsInviting" style="font-size:0.8rem;">+</button>
                                                </div>
                                                @if (!string.IsNullOrEmpty(t.InviteMessage)) { <div class="info" style="font-size:0.75rem; margin-top:4px;">@t.InviteMessage</div> }
                                                @if (!string.IsNullOrEmpty(t.InviteError)) { <div class="error" style="font-size:0.75rem; margin-top:4px;">@t.InviteError</div> }
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

@code {
    private List<JuegoDto> todosLosJuegos = new();
    private List<JuegoDto> juegosDisponiblesParaCrear = new();
    private List<MiEquipoView> misEquipos = new();
    private CrearEquipoDto newTeam = new();
    private bool isLoading = true;
    private bool isCreating = false;
    private string? loadError;
    private string? createMessage;
    private string? createError;

    private class MiEquipoView : MiEquipoDto
    {
        public bool IsEditing { get; set; }
        public string EditNombre { get; set; } = string.Empty;
        public bool IsSaving { get; set; }
        public string? EditError { get; set; }

        public string InviteUsername { get; set; } = string.Empty;
        public bool IsInviting { get; set; }
        public string? InviteMessage { get; set; }
        public string? InviteError { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        loadError = null;
        try
        {
            var juegosTask = ApiClient.GetJuegos();
            var equiposTask = ApiClient.GetMisEquipos();
            var perfilesTask = ApiClient.GetMisPerfilesJuego();

            await Task.WhenAll(juegosTask, equiposTask, perfilesTask);

            todosLosJuegos = await juegosTask;
            var misPerfiles = await perfilesTask;
            var listaEquipos = await equiposTask;

            juegosDisponiblesParaCrear = todosLosJuegos
                .Where(j => misPerfiles.Any(p => p.JuegoId == j.Id))
                .ToList();

            misEquipos = listaEquipos.Select(dto => new MiEquipoView
            {
                Id = dto.Id,
                Nombre = dto.Nombre,
                JuegoId = dto.JuegoId,
                Rol = dto.Rol,
                EditNombre = dto.Nombre
            }).ToList();
        }
        catch (Exception ex)
        {
            loadError = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetJuegoNombre(int juegoId)
    {
        var j = todosLosJuegos.FirstOrDefault(x => x.Id == juegoId);
        return j == null ? "Desconocido" : j.Nombre;
    }

    private async Task CreateTeam()
    {
        createMessage = null;
        createError = null;
        isCreating = true;
        try
        {
            var created = await ApiClient.CrearEquipo(newTeam);
            createMessage = $"Equipo '{created.Nombre}' creado.";
            await LoadData();
            newTeam = new CrearEquipoDto();
        }
        catch (Exception ex)
        {
            createError = ex.Message;
        }
        finally
        {
            isCreating = false;
        }
    }

    private void ViewEquipo(int id)
    {
        Navigation.NavigateTo($"/equipos/{id}");
    }

    private void ToggleEdit(MiEquipoView t)
    {
        t.IsEditing = !t.IsEditing;
        t.EditError = null;
    }

    private void CancelEdit(MiEquipoView t)
    {
        t.IsEditing = false;
        t.EditNombre = t.Nombre;
        t.EditError = null;
    }

    private async Task SaveEdit(MiEquipoView t)
    {
        t.EditError = null;
        t.IsSaving = true;
        try
        {
            var dto = new CrearEquipoDto { Nombre = t.EditNombre, JuegoId = t.JuegoId };
            await ApiClient.ActualizarEquipo(t.Id, dto);
            t.Nombre = t.EditNombre;
            t.IsEditing = false;
        }
        catch (Exception ex)
        {
            t.EditError = ex.Message;
        }
        finally
        {
            t.IsSaving = false;
        }
    }

    private async Task InviteToTeam(MiEquipoView t)
    {
        t.InviteError = null;
        t.InviteMessage = null;
        t.IsInviting = true;
        try
        {
            var dto = new InvitarMiembroDto { Username = t.InviteUsername };
            await ApiClient.AnadirMiembro(t.Id, dto);
            t.InviteMessage = $"Invitación enviada a '{t.InviteUsername}'.";
            t.InviteUsername = string.Empty;
        }
        catch (Exception ex)
        {
            t.InviteError = ex.Message;
        }
        finally
        {
            t.IsInviting = false;
        }
    }

    private async Task ConfirmDisolver(int id)
    {
        if (!await JsConfirmAsync($"¿Deseas disolver el equipo #{id}? Esta acción no se puede deshacer.")) return;
        await DisolverEquipo(id);
    }

    private async Task DisolverEquipo(int id)
    {
        try
        {
            await ApiClient.DisolverEquipo(id);
            await LoadData();
        }
        catch (Exception ex)
        {
            await JsAlertAsync($"Error al disolver: {ex.Message}");
        }
    }

    [Microsoft.AspNetCore.Components.Inject]
    private Microsoft.JSInterop.IJSRuntime JS { get; set; } = default!;

    private async Task<bool> JsConfirmAsync(string message)
    {
        try
        {
            return await JS.InvokeAsync<bool>("confirm", message);
        }
        catch
        {
            return false;
        }
    }

    private async Task JsAlertAsync(string message)
    {
        try
        {
            await JS.InvokeVoidAsync("alert", message);
        }
        catch { }
    }
}
