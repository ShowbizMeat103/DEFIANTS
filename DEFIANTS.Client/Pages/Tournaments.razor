              ButtonText="Ver Detalles" />
    </div>
    <div class="col-md-4">
        <Card Title="Torneo de Primavera"
              Description="La temporada de torneos ha comenzado. ¿Estás listo?"
              ImageUrl="https://via.placeholder.com/300x200"
              Link="/tournaments/primavera"
              ButtonText="Ver Detalles" />
    </div>
</div>