@page "/tournaments"

<h1>Torneos</h1>

<div class="row">
    <div class="col-md-4">
        <Card Title="Torneo de Verano"
              Description="Participa en el torneo de verano y gana grandes premios."
              ImageUrl="https://via.placeholder.com/300x200"
              Link="/tournaments/verano"
              ButtonText="Ver Detalles" />
    </div>
    <div class="col-md-4">
        <Card Title="Torneo de Invierno"
