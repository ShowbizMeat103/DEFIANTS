@page "/admin/crear-juego"
@attribute [Authorize(Roles = "Admin")]
@using Microsoft.AspNetCore.Authorization

@using DEFIANTS.Shared.DTOs
@using DEFIANTS.Shared.Clients
@inject IApiClient ApiClient
@inject NavigationManager NavigationManager

<PageTitle>Crear Nuevo Juego</PageTitle>

<h1>Crear Nuevo Juego (Temp)</h1>
<p>Esta página es temporal para poder añadir juegos al sistema.</p>

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card">
            <div class="card-body">
                <EditForm Model="@nuevoJuego" OnValidSubmit="HandleCrearJuego">
                    <DataAnnotationsValidator />
                    <div class="mb-3">
                        <label for="nombre" class="form-label">Nombre del Juego:</label>
                        <InputText id="nombre" class="form-control" @bind-Value="nuevoJuego.Nombre" />
                        <ValidationMessage For="@(() => nuevoJuego.Nombre)" />
                    </div>
                    <div class="mb-3">
                        <label for="logoUrl" class="form-label">URL del Logo:</label>
                        <InputText id="logoUrl" class="form-control" @bind-Value="nuevoJuego.LogoUrl" />
                        <ValidationMessage For="@(() => nuevoJuego.LogoUrl)" />
                    </div>
                    <div class="mb-3">
                        <label for="integrantes" class="form-label">Integrantes por Equipo:</label>
                        <InputNumber id="integrantes" class="form-control" @bind-Value="nuevoJuego.IntegrantesPorEquipo" />
                        <ValidationMessage For="@(() => nuevoJuego.IntegrantesPorEquipo)" />
                    </div>
                    <div class="mb-3 form-check">
                        <InputCheckbox id="tieneElo" class="form-check-input" @bind-Value="nuevoJuego.TieneSistemaElo" />
                        <label for="tieneElo" class="form-check-label">¿Tiene Sistema de Elo?</label>
                    </div>
                    
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger">@errorMessage</div>
                    }
                    @if (successMessage != null)
                    {
                        <div class="alert alert-success">@successMessage</div>
                    }

                    <button type="submit" class="btn btn-primary">Crear Juego</button>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
    private CrearJuegoDto nuevoJuego = new();
    private string? errorMessage;
    private string? successMessage;

    private async Task HandleCrearJuego()
    {
        errorMessage = null;
        successMessage = null;
        try
        {
            var juegoCreado = await ApiClient.CrearJuego(nuevoJuego);
            successMessage = $"¡Juego '{juegoCreado.Nombre}' creado con éxito! (ID: {juegoCreado.Id})";
            nuevoJuego = new(); // Limpiar el formulario para el siguiente
            StateHasChanged();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al crear el juego: {ex.Message}";
        }
    }
}
