@page "/admin/crear-juego"
@attribute [Authorize(Roles = "Admin")]
@using Microsoft.AspNetCore.Authorization

@using DEFIANTS.Shared.DTOs
@using DEFIANTS.Shared.Clients
@inject IApiClient ApiClient
@inject NavigationManager NavigationManager

<PageTitle>Crear Nuevo Juego</PageTitle>

<div class="container" style="max-width: 800px; margin-top: 40px;">
    
    <!-- HEADER -->
    <div class="dashboard-header">
        <div>
            <p class="system-status">/// ADMIN_ACCESS_GRANTED</p>
            <h1>CREAR <span class="text-red">NUEVO JUEGO</span></h1>
            <p class="header-subtitle">Añade un nuevo título al ecosistema competitivo de DEFIANTS.</p>
        </div>
    </div>

    <!-- FORM CARD -->
    <div class="auth-card" style="max-width: 100%; margin: 0;">
        <EditForm Model="@nuevoJuego" OnValidSubmit="HandleCrearJuego" class="auth-form">
            <DataAnnotationsValidator />

            <div class="form-group mb-4">
                <label class="form-label">NOMBRE DEL JUEGO</label>
                <InputText id="nombre" class="auth-input" @bind-Value="nuevoJuego.Nombre" placeholder="Ej: Valorant, League of Legends..." />
                <ValidationMessage For="@(() => nuevoJuego.Nombre)" />
            </div>

            <div class="form-group mb-4">
                <label class="form-label">URL DEL LOGO</label>
                <InputText id="logoUrl" class="auth-input" @bind-Value="nuevoJuego.LogoUrl" placeholder="https://..." />
                <ValidationMessage For="@(() => nuevoJuego.LogoUrl)" />
            </div>

            <div class="form-group mb-4">
                <label class="form-label">INTEGRANTES POR EQUIPO</label>
                <InputNumber id="integrantes" class="auth-input" @bind-Value="nuevoJuego.IntegrantesPorEquipo" />
                <ValidationMessage For="@(() => nuevoJuego.IntegrantesPorEquipo)" />
            </div>

            <div class="form-group mb-4" style="display: flex; align-items: center; gap: 10px;">
                <InputCheckbox id="tieneElo" class="form-check-input" @bind-Value="nuevoJuego.TieneSistemaElo" style="width: 20px; height: 20px; accent-color: var(--defiant-red);" />
                <label for="tieneElo" class="form-label" style="margin: 0; cursor: pointer;">¿TIENE SISTEMA DE ELO?</label>
            </div>
            
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="auth-error-message">@errorMessage</div>
            }
            @if (successMessage != null)
            {
                <div class="auth-success-message">@successMessage</div>
            }

            <div style="margin-top: 30px;">
                <button type="submit" class="btn btn-primary" style="width: 100%; padding: 15px; font-size: 1.2rem;">
                    INICIALIZAR PROTOCOLO DE JUEGO
                </button>
            </div>
        </EditForm>
    </div>
</div>

<style>
    .form-label {
        display: block;
        font-family: 'Anton', sans-serif;
        color: var(--text-muted);
        margin-bottom: 8px;
        font-size: 0.9rem;
        letter-spacing: 1px;
    }
    .text-red { color: var(--defiant-red); }
    .mb-4 { margin-bottom: 1.5rem; }
</style>

@code {
    private CrearJuegoDto nuevoJuego = new();
    private string? errorMessage;
    private string? successMessage;

    private async Task HandleCrearJuego()
    {
        errorMessage = null;
        successMessage = null;
        try
        {
            var juegoCreado = await ApiClient.CrearJuego(nuevoJuego);
            successMessage = $"¡SISTEMA ACTUALIZADO: JUEGO '{juegoCreado.Nombre.ToUpper()}' AÑADIDO CON ÉXITO!";
            nuevoJuego = new(); // Limpiar el formulario para el siguiente
            StateHasChanged();
        }
        catch (Exception ex)
        {
            errorMessage = $"ERROR CRÍTICO: {ex.Message}";
        }
    }
}
