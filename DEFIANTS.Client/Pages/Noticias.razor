@page "/noticias"

<div class="section section-noticias">
    <div class="container">
        <div class="section-header">
            <h1 class="section-title">// NOTICIAS</h1>
            <p class="section-subtitle">Mantente al tanto de las últimas novedades y actualizaciones de DEFIANTS.</p>
        </div>

        <div class="news-grid">
            @foreach (var noticia in noticias)
            {
                <article class="news-card">
                    <div class="news-image">
                        <img src="@noticia.ImageUrl" alt="@noticia.Titulo" />
                        <span class="news-category">@noticia.Categoria</span>
                    </div>

                    <div class="news-content">
                        <h3>@noticia.Titulo</h3>
                        <p class="news-date">
                            <i class="fas fa-calendar-alt"></i>
                            @noticia.Fecha.ToString("d MMMM yyyy")
                        </p>
                        <p class="news-excerpt">@noticia.Resumen</p>
                        <a href="#" class="news-link">Leer más →</a>
                    </div>
                </article>
            }
        </div>
    </div>
</div>

