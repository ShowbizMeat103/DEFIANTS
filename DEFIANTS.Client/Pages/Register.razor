@page "/registro"
@using DEFIANTS.Shared.Clients
@using DEFIANTS.Shared.DTOs
@using Refit
@inject IApiClient ApiClient
@inject NavigationManager Navigation

<PageTitle>Crear Cuenta</PageTitle>

<div class="auth-container">
    <div class="auth-card">
        <div class="auth-header">
            <img src="/logo.png" alt="DEFIANTS Logo" />
            <h2>Crear Cuenta</h2>
            <p class="auth-subtitle">Únete a la arena de DEFIANTS.</p>
        </div>

        <EditForm Model="@registerDto" OnValidSubmit="HandleRegistration" class="auth-form">
            <DataAnnotationsValidator />

            @if (errorMessages.Any())
            {
                <div class="auth-error-message">
                    <ul>
                        @foreach (var error in errorMessages)
                        {
                            <li>@error</li>
                        }
                    </ul>
                </div>
            }
            @if (isSuccess)
            {
                <div class="auth-success-message">
                    ¡Registro exitoso! Serás redirigido al login...
                </div>
            }

            <InputText @bind-Value="registerDto.Username" placeholder="Gametag" class="auth-input" />
            <ValidationMessage For="@(() => registerDto.Username)" />

            <InputText @bind-Value="registerDto.Email" type="email" placeholder="Correo electrónico" class="auth-input" />
            <ValidationMessage For="@(() => registerDto.Email)" />

            <InputText @bind-Value="registerDto.Password" type="password" placeholder="Contraseña" class="auth-input" />
            <ValidationMessage For="@(() => registerDto.Password)" />

            <button type="submit" class="auth-submit" disabled="@isSubmitting">
                @if (isSubmitting)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    <span> Creando cuenta...</span>
                }
                else
                {
                    <span>Registrarse</span>
                }
            </button>
        </EditForm>

        <p class="auth-switch">
            ¿Ya tienes una cuenta?
            <a href="/login">Inicia sesión aquí</a>
        </p>
    </div>
</div>

@code {
    private RegisterDto registerDto = new();
    private List<string> errorMessages = new();
    private bool isSubmitting = false;
    private bool isSuccess = false;

    private async Task HandleRegistration()
    {
        isSubmitting = true;
        errorMessages.Clear();
        isSuccess = false;
        StateHasChanged();

        try
        {
            await ApiClient.Register(registerDto);
            isSuccess = true;
            StateHasChanged();

            await Task.Delay(3000);
            Navigation.NavigateTo("/login");
        }
        catch (ApiException ex)
        {
            switch (ex.StatusCode)
            {
                case System.Net.HttpStatusCode.BadRequest when ex.Content != null:
                {
                    var errorResponse = System.Text.Json.JsonSerializer.Deserialize<ErrorResponseDto>(ex.Content, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                    if (errorResponse?.Errors != null)
                    {
                        errorMessages = errorResponse.Errors.Select(e => e.Description).ToList();
                    }
                    else
                    {
                        errorMessages.Add("Ocurrió un error con los datos enviados.");
                    }
                    break;
                }
                case System.Net.HttpStatusCode.Conflict:
                    errorMessages.Add("El nombre de usuario o el email ya están en uso.");
                    break;
                default:
                    errorMessages.Add("Ocurrió un error inesperado. Por favor, intenta de nuevo.");
                    break;
            }
        }
        catch (Exception)
        {
            errorMessages.Add("Ocurrió un error de conexión. Por favor, revisa tu conexión a internet.");
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }
}
