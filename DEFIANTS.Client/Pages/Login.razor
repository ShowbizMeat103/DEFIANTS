@page "/login"
@using DEFIANTS.Shared.Clients
@using DEFIANTS.Shared.DTOs
@using Refit
@inject IApiClient ApiClient
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@inject NavigationManager Navigation

<PageTitle>Iniciar Sesión</PageTitle>

<div class="auth-container">
    <div class="auth-card">

        <div class="auth-header">
            <img src="/logo.png" alt="DEFIANTS Logo" />
            <h2>Iniciar Sesión</h2>
        </div>

        <EditForm Model="@loginDto" OnValidSubmit="HandleLogin" class="auth-form">
            <DataAnnotationsValidator />

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="auth-error-message">@errorMessage</div>
            }

            <InputText
                @bind-Value="loginDto.Username"
                placeholder="Gametag"
                class="auth-input"
                @oninput="@(() => errorMessage = null)" />
            <ValidationMessage For="@(() => loginDto.Username)" />

            <InputText
                @bind-Value="loginDto.Password"
                type="password"
                placeholder="Contraseña"
                class="auth-input"
                @oninput="@(() => errorMessage = null)" />
            <ValidationMessage For="@(() => loginDto.Password)" />

            <button type="submit" class="auth-submit" disabled="@isSubmitting">
                @if (isSubmitting)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    <span> Ingresando...</span>
                }
                else
                {
                    <span>Entrar</span>
                }
            </button>
        </EditForm>

        <p class="auth-switch">
            ¿No tienes una cuenta?
            <a href="/registro">Regístrate aquí</a>
        </p>
    </div>
</div>

@code {
    private LoginDto loginDto = new();
    private string? errorMessage;
    private bool isSubmitting = false;

    private async Task HandleLogin()
    {
        isSubmitting = true;
        errorMessage = null;

        try
        {
            var result = await ApiClient.Login(loginDto);
            await LocalStorage.SetItemAsync("authToken", result.Token);
            
            Navigation.NavigateTo("/", forceLoad: true);
        }
        catch (ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            errorMessage = "Gametag o contraseña incorrectos.";
        }
        catch (Exception)
        {
            errorMessage = "Error de conexión. Inténtalo de nuevo.";
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
