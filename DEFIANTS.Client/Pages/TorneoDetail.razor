@page "/torneos/{id:int}"
@using DEFIANTS.Shared.DTOs
@using DEFIANTS.Shared.Enums
@using DEFIANTS.Shared.Clients
@using System.Security.Claims
@inject IApiClient ApiClient
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet" />
<link href="https://fonts.googleapis.com/css2?family=Anton&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet" />

<div class="dashboard-layout">
    <div class="container">
        @if (isLoading)
        {
            <div class="loading-screen">
                <div class="spinner-border text-danger" role="status"></div>
                <p>/// ACCEDIENDO A DATOS DEL TORNEO...</p>
            </div>
        }
        else if (!string.IsNullOrEmpty(error))
        {
            <div class="error-screen">
                <i class="fas fa-exclamation-triangle fa-3x mb-3 text-danger"></i>
                <h3>ERROR DE SISTEMA</h3>
                <p>@error</p>
                <button class="btn-ghost" @onclick="GoBack">VOLVER A BASE</button>
            </div>
        }
        else if (torneo is null)
        {
            <div class="error-screen">
                <h3>404 // TORNEO NO ENCONTRADO</h3>
                <button class="btn-ghost" @onclick="GoBack">VOLVER A BASE</button>
            </div>
        }
        else
        {
            <header class="tournament-header">
                <div class="header-top">
                    <p class="system-status">/// SYSTEM_TRACKING /// ID: @id.ToString("D4")</p>
                    <button class="btn-back" @onclick="GoBack"><i class="fas fa-arrow-left"></i> VOLVER</button>
                </div>

                <div class="title-row">
                    <h1>@torneo.Titulo.ToUpper()</h1>
                    <span class="status-badge @torneo.Status.ToLower()">
                        <i class="fas fa-circle status-dot"></i> @torneo.Status.ToUpper()
                    </span>
                </div>

                <div class="stats-strip">
                    <div class="stat-item">
                        <span class="label">JUEGO</span>
                        <span class="value">@torneo.JuegoNombre?.ToUpper()</span>
                    </div>
                    <div class="stat-item">
                        <span class="label">INICIO</span>
                        <span class="value">@torneo.FechaInicio.ToString("dd MMM yyyy").ToUpper()</span>
                    </div>
                    <div class="stat-item">
                        <span class="label">PRIZE POOL</span>
                        <span class="value text-gold">@torneo.PrizePool.ToString("C0")</span>
                    </div>
                    <div class="stat-item">
                        <span class="label">INSCRITOS</span>
                        <span class="value">@torneo.Inscripciones.Count / @torneo.MaxEquipos</span>
                    </div>
                </div>
            </header>

            <div class="control-bar">
                <div class="tabs">
                    <button class="tab-btn @GetTabClass("bracket")" @onclick='() => SetTab("bracket")'>// BRACKET</button>
                    <button class="tab-btn @GetTabClass("equipos")" @onclick='() => SetTab("equipos")'>// ESCUADRAS</button>
                    <button class="tab-btn @GetTabClass("info")" @onclick='() => SetTab("info")'>// INTEL</button>
                </div>

                <AuthorizeView>
                    <Authorized>
                        <div class="actions-zone">
                            @if (torneo.Status == "InscripcionesAbiertas" && equiposDelUsuarioParaInscribir.Any())
                            {
                                <div class="inscription-group">
                                    <select @bind="equipoSeleccionadoParaInscribirId" class="form-select-custom">
                                        <option value="0">-- SELECCIONAR UNIDAD --</option>
                                        @foreach (var equipo in equiposDelUsuarioParaInscribir)
                                        {
                                            <option value="@equipo.Id">@equipo.Nombre</option>
                                        }
                                    </select>
                                    <button class="btn-primary" @onclick="HandleInscribirEquipo" disabled="@(equipoSeleccionadoParaInscribirId == 0 || isSubmitting)">
                                        @(isSubmitting ? "PROCESANDO..." : "INSCRIBIR")
                                    </button>
                                </div>
                            }

                            @if (esCreadorOAdmin)
                            {
                                <div class="admin-controls">
                                    <span class="admin-label">ADMIN //</span>
                                    @if (torneo.Status == "InscripcionesAbiertas")
                                    {
                                        <button class="btn-action start" @onclick="HandleIniciarTorneo" disabled="@isSubmitting">
                                            <i class="fas fa-play"></i> INICIAR
                                        </button>
                                    }
                                    <button class="btn-action cancel" @onclick="HandleCancelarTorneo" disabled="@isSubmitting">
                                        <i class="fas fa-ban"></i> CANCELAR
                                    </button>
                                </div>
                            }
                        </div>
                    </Authorized>
                </AuthorizeView>
            </div>

            <div class="tab-content-area">
                @if (activeTab == "bracket")
                {
                    <div class="bracket-container">
                        @if (esCreadorOAdmin)
                        {
                            <div class="system-message">
                                <i class="fas fa-info-circle"></i> MODO ADMIN: Selecciona un partido activo para reportar el resultado.
                            </div>
                        }

                        @if (torneo.Partidos == null || !torneo.Partidos.Any())
                        {
                            <div class="empty-state">
                                <i class="fas fa-network-wired"></i>
                                <p>BRACKET AÚN NO GENERADO</p>
                            </div>
                        }
                        else
                        {
                            <div class="bracket-scroll">
                                @foreach (var rondaGroup in Rondas)
                                {
                                    <div class="round-column">
                                        <div class="round-header">RONDA @rondaGroup.Key</div>
                                        <div class="round-matches">
                                            @foreach (var partido in rondaGroup.OrderBy(p => p.IndicePartido))
                                            {
                                                <div class="match-card @GetMatchStateClass(partido) @(CanReport(partido) ? "clickable" : "")"
                                                     @onclick="() => OpenReportModal(partido)">

                                                    <div class="match-id">#@partido.Id</div>

                                                    <div class="match-team team-a @(IsWinner(partido, partido.EquipoAId) ? "winner" : "")">
                                                        <span class="name">@DisplayTeam(partido.EquipoANombre)</span>
                                                        @if(IsWinner(partido, partido.EquipoAId)) { <i class="fas fa-check text-success"></i> }
                                                    </div>

                                                    <div class="match-divider">VS</div>

                                                    <div class="match-team team-b @(IsWinner(partido, partido.EquipoBId) ? "winner" : "")">
                                                        <span class="name">@DisplayTeam(partido.EquipoBNombre)</span>
                                                        @if(IsWinner(partido, partido.EquipoBId)) { <i class="fas fa-check text-success"></i> }
                                                    </div>

                                                    <div class="match-status">
                                                        @partido.Estado.ToString().ToUpper()
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }

                                @{ var champion = GetChampionName(); }
                                @if (champion != null)
                                {
                                    <div class="round-column champion-column">
                                        <div class="round-header">GANADOR</div>
                                        <div class="champion-card">
                                            <div class="trophy-glow"></div>
                                            <i class="fas fa-trophy trophy-icon"></i>
                                            <div class="champion-name">@champion</div>
                                            <div class="champion-label">CAMPEÓN SUPREMO</div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
                else if (activeTab == "equipos")
                {
                    <div class="dashboard-grid">
                        @if (!torneo.Inscripciones.Any())
                        {
                            <div class="empty-state">
                                <p>SIN INSCRIPCIONES ACTIVAS</p>
                            </div>
                        }
                        else
                        {
                            @foreach (var inscripcion in torneo.Inscripciones)
                            {
                                <div class="dashboard-card team-entry">
                                    <div class="team-icon"><i class="fas fa-users"></i></div>
                                    <h3>@inscripcion.NombreEquipo</h3>
                                    <span class="status-ok">CONFIRMADO</span>
                                </div>
                            }
                        }
                    </div>
                }
                else if (activeTab == "info")
                {
                    <div class="dashboard-card info-card">
                        <h3><i class="fas fa-file-alt"></i> REGLAS Y DETALLES</h3>
                        <div class="info-grid">
                            <div class="info-row">
                                <label>PRECIO DE INSCRIPCIÓN</label>
                                <span>@torneo.PrecioInscripcion.ToString("C")</span>
                            </div>
                            <div class="info-row">
                                <label>FORMATO</label>
                                <span>ELIMINACIÓN DIRECTA (BO1)</span>
                            </div>
                            <div class="info-row">
                                <label>CUPO MÁXIMO</label>
                                <span>@torneo.MaxEquipos EQUIPOS</span>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @if (showReportModal && selectedPartido != null)
            {
                <div class="modal-backdrop-custom">
                    <div class="modal-custom">
                        <div class="modal-header">
                            <h4>/// REPORTE DE BATALLA</h4>
                        </div>
                        <div class="modal-body">
                            <p>CONFIRMA EL EQUIPO VICTORIOSO:</p>
                            <div class="versus-selection">
                                <button class="btn-selection team-a" @onclick="() => ReportWinner(selectedPartido.EquipoAId!.Value)">
                                    <span class="select-label">GANADOR</span>
                                    <span class="select-name">@selectedPartido.EquipoANombre</span>
                                </button>
                                <div class="vs-text">VS</div>
                                <button class="btn-selection team-b" @onclick="() => ReportWinner(selectedPartido.EquipoBId!.Value)">
                                    <span class="select-label">GANADOR</span>
                                    <span class="select-name">@selectedPartido.EquipoBNombre</span>
                                </button>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button class="btn-ghost" @onclick="CloseReportModal">CANCELAR</button>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

@code {
    [Parameter]
    public int id { get; set; }

    private TorneoDetalleDto? torneo;
    private List<MiEquipoDto> equiposDelUsuario = new();
    private bool isLoading = true;
    private string? error;
    private string activeTab = "bracket";
    private bool esCreadorOAdmin = false;
    private bool isSubmitting = false;
    private int equipoSeleccionadoParaInscribirId = 0;

    private bool showReportModal = false;
    private PartidoDto? selectedPartido;

    private List<MiEquipoDto> equiposDelUsuarioParaInscribir =>
        equiposDelUsuario.Where(e => e.JuegoId == torneo?.JuegoId && (torneo?.Inscripciones.All(i => i.EquipoId != e.Id) ?? true)).ToList();

    private IOrderedEnumerable<IGrouping<int, PartidoDto>> Rondas =>
        (torneo?.Partidos ?? new List<PartidoDto>())
            .GroupBy(p => p.Ronda)
            .OrderBy(g => g.Key);

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        error = null;
        torneo = null;
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            var torneoTask = ApiClient.GetTorneo(id);
            var misEquiposTask = user.Identity.IsAuthenticated ? ApiClient.GetMisEquipos() : Task.FromResult(new List<MiEquipoDto>());

            await Task.WhenAll(torneoTask, misEquiposTask);

            torneo = await torneoTask;
            equiposDelUsuario = await misEquiposTask;

            if (user.Identity.IsAuthenticated)
            {
                var userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
                esCreadorOAdmin = (torneo?.CreadorId == userId || user.IsInRole("Admin"));
            }
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetTabClass(string tabName) => activeTab == tabName ? "active" : "";
    private void SetTab(string tabName) => activeTab = tabName;

    private string GetMatchStateClass(PartidoDto p)
    {
        if (p.Estado == EstadoPartido.Finalizado) return "finished";
        if (p.Estado == EstadoPartido.EnJuego) return "live";
        return "pending";
    }

    private string? GetChampionName()
    {
        if (torneo?.Partidos == null || !torneo.Partidos.Any()) return null;

        var maxRonda = torneo.Partidos.Max(p => p.Ronda);
        var finalMatches = torneo.Partidos.Where(p => p.Ronda == maxRonda).ToList();

        if (finalMatches.Count == 1)
        {
            var final = finalMatches.First();
            if (final.Estado == EstadoPartido.Finalizado && final.EquipoGanadorId.HasValue)
            {
                return final.EquipoGanadorId == final.EquipoAId ? final.EquipoANombre : final.EquipoBNombre;
            }
        }
        return null;
    }

    private async Task HandleInscribirEquipo()
    {
        isSubmitting = true;
        try
        {
            var dto = new InscribirEquipoDto { EquipoId = equipoSeleccionadoParaInscribirId };
            await ApiClient.InscribirEquipo(id, dto);
            await OnParametersSetAsync();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { isSubmitting = false; }
    }

    private async Task HandleIniciarTorneo()
    {
        isSubmitting = true;
        try
        {
            await ApiClient.IniciarTorneo(id);
            await OnParametersSetAsync();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { isSubmitting = false; }
    }

    private async Task HandleCancelarTorneo()
    {
        isSubmitting = true;
        try
        {
            await ApiClient.CancelarTorneo(id);
            await OnParametersSetAsync();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { isSubmitting = false; }
    }

    private bool CanReport(PartidoDto p)
    {
        return esCreadorOAdmin &&
               (p.Estado == EstadoPartido.Listo || p.Estado == EstadoPartido.EnJuego) &&
               p.EquipoAId.HasValue && p.EquipoBId.HasValue;
    }

    private void OpenReportModal(PartidoDto p)
    {
        if (CanReport(p))
        {
            selectedPartido = p;
            showReportModal = true;
        }
    }

    private void CloseReportModal()
    {
        showReportModal = false;
        selectedPartido = null;
    }

    private async Task ReportWinner(int ganadorId)
    {
        if (selectedPartido == null) return;

        isSubmitting = true;
        try
        {
            await ApiClient.ReportarVictoria(selectedPartido.Id, ganadorId);
            CloseReportModal();
            await OnParametersSetAsync();
        }
        catch (Exception ex)
        {
            error = $"Error al reportar victoria: {ex.Message}";
            CloseReportModal();
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private string DisplayTeam(string? name) => string.IsNullOrWhiteSpace(name) ? "TBD" : name;
    private bool IsWinner(PartidoDto p, int? equipoId) => equipoId.HasValue && p.EquipoGanadorId.HasValue && p.EquipoGanadorId.Value == equipoId.Value;
    private void GoBack() => Navigation.NavigateTo("/tournaments");
}
