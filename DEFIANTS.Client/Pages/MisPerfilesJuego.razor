@page "/mis-perfiles-juego"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using DEFIANTS.Shared.DTOs
@using DEFIANTS.Shared.Clients
@inject IApiClient ApiClient
@inject IJSRuntime JSRuntime

<PageTitle>Mis Perfiles de Juego</PageTitle>

<h1>Mis Perfiles de Juego</h1>
<p class="mb-4">Gestiona tus identidades para cada juego. Necesitas al menos un perfil para unirte a equipos y torneos.</p>

<!-- Zona de Notificaciones -->
@if (!string.IsNullOrEmpty(notificationMessage))
{
    <div class="alert @notificationCssClass alert-dismissible fade show" role="alert">
        @notificationMessage
        <button type="button" class="btn-close" @onclick="() => notificationMessage = null"></button>
    </div>
}

@if (misPerfiles == null)
{
    <div class="text-center"><div class="spinner-border text-primary" role="status"></div> <p>Cargando...</p></div>
}
else if (!misPerfiles.Any() && !showCreateForm)
{
    <div class="row justify-content-center text-center mt-5">
        <div class="col-md-8"><div class="card card-body">
            <h3>Aún no tienes perfiles de juego</h3>
            <p>Para competir, primero necesitas decirnos cómo te llamas en tus juegos.</p>
            <button class="btn btn-primary btn-lg" @onclick="() => showCreateForm = true"><i class="fas fa-plus-circle me-2"></i> Crear mi primer perfil</button>
        </div></div>
    </div>
}
else
{
    <div class="row">
        <div class="col-lg-3 mb-3">
            <div class="d-grid">
                 <button class="btn btn-primary" @onclick="() => showCreateForm = !showCreateForm">
                    <i class="fas @(showCreateForm ? "fa-times" : "fa-plus") me-2"></i>
                    <span>@(showCreateForm ? "Cancelar" : "Añadir Perfil")</span>
                </button>
            </div>
        </div>
        <div class="col-lg-9">
            @if (misPerfiles.Any())
            {
                <div class="row row-cols-1 row-cols-md-2 g-4">
                    @foreach (var perfil in misPerfiles)
                    {
                        <div class="col">
                            <div class="card h-100 shadow-sm">
                                <div class="card-body d-flex flex-column">
                                    <div class="d-flex align-items-start mb-2">
                                        <img src="@(string.IsNullOrEmpty(perfil.JuegoLogoUrl) ? "https://via.placeholder.com/40" : $"/img/logos/{perfil.JuegoLogoUrl}")" alt="@perfil.JuegoNombre" class="me-3" style="width: 40px; height: 40px; border-radius: 4px; object-fit: cover;">
                                        <div>
                                            <h5 class="card-title mb-0">@perfil.JuegoNombre</h5>
                                            @if (perfil.JuegoTieneSistemaElo)
                                            {
                                                <span class="badge bg-info">ELO: @perfil.Elo</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Sin ELO</span>
                                            }
                                        </div>
                                    </div>

                                    @if (editingProfileId == perfil.Id)
                                    {
                                        <div class="mt-auto">
                                            <label class="form-label small">Editando <strong>@perfil.JuegoNombre</strong>:</label>
                                            <div class="input-group mb-2">
                                                <span class="input-group-text" style="width: 80px;">Nombre</span>
                                                <input @bind="editingNickname" class="form-control" />
                                            </div>
                                            @if (perfil.JuegoTieneSistemaElo)
                                            {
                                                <div class="input-group">
                                                    <span class="input-group-text" style="width: 80px;">ELO</span>
                                                    <input type="number" @bind="editingElo" class="form-control" />
                                                </div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <p class="card-text fs-4 mt-auto">@perfil.NicknameInGame</p>
                                    }
                                </div>
                                <div class="card-footer bg-transparent border-top-0 text-end">
                                    @if (editingProfileId == perfil.Id)
                                    {
                                        <button class="btn btn-sm btn-success" @onclick="() => HandleActualizarPerfil(perfil)" disabled="@isSaving">
                                            @if(isSaving) { <span class="spinner-border spinner-border-sm"></span> }
                                            Guardar
                                        </button>
                                        <button class="btn btn-sm btn-secondary" @onclick="() => editingProfileId = null">Cancelar</button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-outline-primary me-2" @onclick="() => StartEditing(perfil)" title="Editar perfil">
                                            <i class="fas fa-pencil-alt"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => HandleEliminarPerfil(perfil)" title="Eliminar perfil">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else if(!showCreateForm)
            {
                 <p>No tienes perfiles. ¡Añade uno para empezar!</p>
            }
        </div>
    </div>
}

@if (showCreateForm)
{
    <div class="row justify-content-center mt-4">
        <div class="col-md-6"><div class="card"><div class="card-header"><h4>Nuevo Perfil de Juego</h4></div>
            <div class="card-body">
                <EditForm Model="@nuevoPerfil" OnValidSubmit="HandleCrearPerfil">
                    <DataAnnotationsValidator />
                    <div class="mb-3">
                        <label class="form-label">Juego:</label>
                        <InputSelect class="form-select" @bind-Value="nuevoPerfil.JuegoId">
                            <option value="0">Selecciona un juego...</option>
                            @if (juegosDisponibles != null)
                            {
                                @foreach (var juego in juegosDisponibles)
                                {
                                    <option value="@juego.Id" disabled="@(misPerfiles?.Any(p => p.JuegoId == juego.Id) ?? false)">@juego.Nombre</option>
                                }
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => nuevoPerfil.JuegoId)" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Tu nombre en el juego:</label>
                        <InputText class="form-control" @bind-Value="nuevoPerfil.NicknameInGame" placeholder="Ej: TheLegend27" />
                        <ValidationMessage For="@(() => nuevoPerfil.NicknameInGame)" />
                    </div>
                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary" disabled="@isSaving">
                            @if(isSaving) { <span class="spinner-border spinner-border-sm"></span> }
                            Guardar Perfil
                        </button>
                    </div>
                </EditForm>
            </div>
        </div></div>
    </div>
}

@code {
    private List<PerfilJuegoDto>? misPerfiles;
    private List<JuegoDto>? juegosDisponibles;
    private CrearPerfilJuegoDto nuevoPerfil = new();
    private bool showCreateForm = false;
    private bool isSaving = false;

    private int? editingProfileId;
    private string editingNickname = "";
    private int editingElo;

    private string? notificationMessage;
    private string notificationCssClass = "alert-success";

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        var misPerfilesTask = ApiClient.GetMisPerfilesJuego();
        var juegosDisponiblesTask = ApiClient.GetJuegos();
        await Task.WhenAll(misPerfilesTask, juegosDisponiblesTask);
        misPerfiles = await misPerfilesTask;
        juegosDisponibles = await juegosDisponiblesTask;
    }

    private async Task HandleCrearPerfil()
    {
        isSaving = true;
        try
        {
            var perfilCreado = await ApiClient.CrearPerfilJuego(nuevoPerfil);
            await LoadData();
            showCreateForm = false;
            nuevoPerfil = new();
            ShowNotification($"Perfil '{perfilCreado.NicknameInGame}' para '{perfilCreado.JuegoNombre}' creado con éxito.", true);
        }
        catch (Exception ex)
        {
            ShowNotification($"Error al crear el perfil: {ex.Message}", false);
        }
        finally
        {
            isSaving = false;
        }
    }

    private void StartEditing(PerfilJuegoDto perfil)
    {
        editingProfileId = perfil.Id;
        editingNickname = perfil.NicknameInGame;
        editingElo = perfil.Elo;
    }

    private async Task HandleActualizarPerfil(PerfilJuegoDto perfil)
    {
        isSaving = true;
        try
        {
            var dto = new ActualizarPerfilJuegoDto
            {
                NicknameInGame = editingNickname,
                Elo = perfil.JuegoTieneSistemaElo ? editingElo : null
            };
            await ApiClient.ActualizarPerfilJuego(perfil.Id, dto);
            
            perfil.NicknameInGame = editingNickname;
            if (perfil.JuegoTieneSistemaElo)
            {
                perfil.Elo = editingElo;
            }
            
            editingProfileId = null;
            ShowNotification($"Perfil de '{perfil.JuegoNombre}' actualizado.", true);
        }
        catch (Exception ex)
        {
            ShowNotification($"Error al actualizar: {ex.Message}", false);
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task HandleEliminarPerfil(PerfilJuegoDto perfil)
    {
        var confirmado = await JSRuntime.InvokeAsync<bool>("confirm", $"¿Estás seguro de que quieres eliminar tu perfil '{perfil.NicknameInGame}' de '{perfil.JuegoNombre}'?");
        if (confirmado)
        {
            // No usamos isSaving aquí para no deshabilitar otros botones
            try
            {
                await ApiClient.EliminarPerfilJuego(perfil.Id);
                await LoadData(); 
                ShowNotification($"Perfil de '{perfil.JuegoNombre}' eliminado.", true);
            }
            catch (Exception ex)
            {
                ShowNotification($"Error al eliminar: {ex.Message}", false);
            }
        }
    }

    private void ShowNotification(string message, bool isSuccess)
    {
        notificationMessage = message;
        notificationCssClass = isSuccess ? "alert-success" : "alert-danger";
        StateHasChanged();
    }
}
