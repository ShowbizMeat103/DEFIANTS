@page "/mis-perfiles-juego"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using DEFIANTS.Shared.DTOs
@using DEFIANTS.Shared.Clients
@inject IApiClient ApiClient
@inject IJSRuntime JSRuntime

<PageTitle>Mis Perfiles de Juego</PageTitle>

<div class="container" style="max-width: 1200px; margin-top: 40px;">

    <!-- HEADER -->
    <div class="dashboard-header">
        <div>
            <p class="system-status">/// IDENTIDAD_DE_COMBATE_ACTIVA</p>
            <h1>MIS PERFILES <span class="text-red">DE JUEGO</span></h1>
            <p class="header-subtitle">Gestiona tus alias y ELO para cada arena. Tu identidad es tu arma.</p>
        </div>
        <!-- Botón corregido para usar estilo rojo -->
        <button class="btn-action" style="width: auto; padding: 10px 20px;" @onclick="() => showCreateForm = !showCreateForm">
            <i class="fas @(showCreateForm ? "fa-times" : "fa-plus")"></i>
            <span>@(showCreateForm ? "CANCELAR" : "AÑADIR PERFIL")</span>
        </button>
    </div>

    <!-- FORMULARIO DE CREACIÓN (CONDICIONAL) -->
    @if (showCreateForm)
    {
        <div class="auth-card creation-form mb-4">
            <h3 class="form-title">NUEVO PROTOCOLO DE IDENTIDAD</h3>
            <EditForm Model="@nuevoPerfil" OnValidSubmit="HandleCrearPerfil" class="auth-form">
                <DataAnnotationsValidator />
                <div class="row">
                    <div class="col-md-6">
                        <label class="form-label">JUEGO</label>
                        <InputSelect class="auth-input" @bind-Value="nuevoPerfil.JuegoId" @bind-Value:after="OnJuegoSeleccionado">
                            <option value="0">Selecciona una arena...</option>
                            @if (juegosDisponibles != null)
                            {
                                @foreach (var juego in juegosDisponibles)
                                {
                                    <option value="@juego.Id" disabled="@(misPerfiles?.Any(p => p.JuegoId == juego.Id) ?? false)">@juego.Nombre</option>
                                }
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => nuevoPerfil.JuegoId)" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">ALIAS EN EL JUEGO</label>
                        <InputText class="auth-input" @bind-Value="nuevoPerfil.NicknameInGame" placeholder="Ej: TheLegend27" />
                        <ValidationMessage For="@(() => nuevoPerfil.NicknameInGame)" />
                    </div>
                </div>
                 @if (juegoSeleccionadoTieneElo)
                {
                    <div class="row mt-3">
                        <div class="col-md-6">
                            <label class="form-label">ELO INICIAL (OPCIONAL)</label>
                            <InputNumber class="auth-input" @bind-Value="nuevoPerfil.Elo" />
                            <ValidationMessage For="@(() => nuevoPerfil.Elo)" />
                        </div>
                    </div>
                }
                <!-- Botón de guardar corregido -->
                <button type="submit" class="btn-primary mt-3" disabled="@isSaving" style="width: auto; padding: 10px 30px; border: none;">
                    @if(isSaving) { <span class="spinner-border spinner-border-sm"></span> }
                    GUARDAR IDENTIDAD
                </button>
            </EditForm>
        </div>
    }
    
    <!-- NOTIFICACIONES -->
    @if (!string.IsNullOrEmpty(notificationMessage))
    {
        <div class="auth-@notificationCssClass mb-4">
            @notificationMessage
        </div>
    }

    <!-- LISTA DE PERFILES -->
    @if (misPerfiles == null)
    {
        <div class="loading-state">Cargando perfiles...</div>
    }
    else if (!misPerfiles.Any())
    {
        <div class="empty-state">
            <h3>SIN IDENTIDAD REGISTRADA</h3>
            <p>Para competir, primero necesitas crear un perfil de juego.</p>
            <!-- Botón de estado vacío corregido -->
            <button class="btn-primary" style="border: none; margin-top: 15px;" @onclick="() => showCreateForm = true">CREAR MI PRIMER PERFIL</button>
        </div>
    }
    else
    {
        <div class="profiles-grid">
            @foreach (var perfil in misPerfiles)
            {
                <div class="profile-card @(editingProfileId == perfil.Id ? "editing" : "")">
                    <div class="card-header">
                        <img src="@(string.IsNullOrEmpty(perfil.JuegoLogoUrl) ? "https://via.placeholder.com/40" : $"/img/logos/{perfil.JuegoLogoUrl}")" alt="@perfil.JuegoNombre" class="game-logo">
                        <div class="game-info">
                            <span class="game-name">@perfil.JuegoNombre</span>
                            @if (perfil.JuegoTieneSistemaElo)
                            {
                                <span class="elo-badge">ELO: @perfil.Elo</span>
                            }
                        </div>
                    </div>

                    <div class="card-body">
                        @if (editingProfileId == perfil.Id)
                        {
                            <div class="edit-mode">
                                <InputText @bind-Value="editingNickname" class="auth-input" />
                                @if (perfil.JuegoTieneSistemaElo)
                                {
                                    <InputNumber @bind-Value="editingElo" class="auth-input mt-2" />
                                }
                            </div>
                        }
                        else
                        {
                            <p class="nickname">@perfil.NicknameInGame</p>
                        }
                    </div>

                    <div class="card-footer">
                        @if (editingProfileId == perfil.Id)
                        {
                            <button class="btn-action-sm success" @onclick="() => HandleActualizarPerfil(perfil)" disabled="@isSaving">
                                @if(isSaving) { <span class="spinner-border spinner-border-sm"></span> }
                                <i class="fas fa-save"></i>
                            </button>
                            <button class="btn-action-sm secondary" @onclick="() => editingProfileId = null">
                                <i class="fas fa-times"></i>
                            </button>
                        }
                        else
                        {
                            <button class="btn-action-sm" @onclick="() => StartEditing(perfil)">
                                <i class="fas fa-pencil-alt"></i>
                            </button>
                            <button class="btn-action-sm danger" @onclick="() => HandleEliminarPerfil(perfil)">
                                <i class="fas fa-trash-alt"></i>
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<PerfilJuegoDto>? misPerfiles;
    private List<JuegoDto>? juegosDisponibles;
    private CrearPerfilJuegoDto nuevoPerfil = new();
    private bool showCreateForm = false;
    private bool isSaving = false;

    private int? editingProfileId;
    private string editingNickname = "";
    private int editingElo;

    private string? notificationMessage;
    private string notificationCssClass = "success-message";
    
    private bool juegoSeleccionadoTieneElo = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            var misPerfilesTask = ApiClient.GetMisPerfilesJuego();
            var juegosDisponiblesTask = ApiClient.GetJuegos();
            await Task.WhenAll(misPerfilesTask, juegosDisponiblesTask);
            misPerfiles = await misPerfilesTask;
            juegosDisponibles = await juegosDisponiblesTask;
        }
        catch (Exception ex)
        {
            ShowNotification($"Error crítico al cargar datos: {ex.Message}", false);
        }
    }
    
    private void OnJuegoSeleccionado()
    {
        var juegoSeleccionado = juegosDisponibles?.FirstOrDefault(j => j.Id == nuevoPerfil.JuegoId);
        juegoSeleccionadoTieneElo = juegoSeleccionado?.TieneSistemaElo ?? false;
        if (!juegoSeleccionadoTieneElo)
        {
            nuevoPerfil.Elo = 0;
        }
    }

    private async Task HandleCrearPerfil()
    {
        isSaving = true;
        try
        {
            var perfilCreado = await ApiClient.CrearPerfilJuego(nuevoPerfil);
            misPerfiles?.Add(perfilCreado);
            showCreateForm = false;
            nuevoPerfil = new();
            juegoSeleccionadoTieneElo = false;
            ShowNotification($"Perfil '{perfilCreado.NicknameInGame}' para '{perfilCreado.JuegoNombre}' creado.", true);
        }
        catch (Exception ex)
        {
            ShowNotification($"Error al crear el perfil: {ex.Message}", false);
        }
        finally
        {
            isSaving = false;
        }
    }

    private void StartEditing(PerfilJuegoDto perfil)
    {
        editingProfileId = perfil.Id;
        editingNickname = perfil.NicknameInGame;
        editingElo = perfil.Elo;
    }

    private async Task HandleActualizarPerfil(PerfilJuegoDto perfil)
    {
        isSaving = true;
        try
        {
            var dto = new ActualizarPerfilJuegoDto
            {
                NicknameInGame = editingNickname,
                Elo = perfil.JuegoTieneSistemaElo ? editingElo : null
            };
            await ApiClient.ActualizarPerfilJuego(perfil.Id, dto);
            
            perfil.NicknameInGame = editingNickname;
            if (perfil.JuegoTieneSistemaElo)
            {
                perfil.Elo = editingElo;
            }
            
            editingProfileId = null;
            ShowNotification($"Perfil de '{perfil.JuegoNombre}' actualizado.", true);
        }
        catch (Exception ex)
        {
            ShowNotification($"Error al actualizar: {ex.Message}", false);
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task HandleEliminarPerfil(PerfilJuegoDto perfil)
    {
        var confirmado = await JSRuntime.InvokeAsync<bool>("confirm", $"¿Estás seguro de que quieres eliminar tu perfil '{perfil.NicknameInGame}' de '{perfil.JuegoNombre}'?");
        if (confirmado)
        {
            try
            {
                await ApiClient.EliminarPerfilJuego(perfil.Id);
                misPerfiles?.Remove(perfil);
                ShowNotification($"Perfil de '{perfil.JuegoNombre}' eliminado.", true);
            }
            catch (Exception ex)
            {
                ShowNotification($"Error al eliminar: {ex.Message}", false);
            }
        }
    }

    private void ShowNotification(string message, bool isSuccess)
    {
        notificationMessage = message;
        notificationCssClass = isSuccess ? "success-message" : "error-message";
        StateHasChanged();
        
        // Auto-hide notification
        _ = Task.Delay(4000).ContinueWith(_ => { 
            notificationMessage = null;
            StateHasChanged();
        });
    }
}
